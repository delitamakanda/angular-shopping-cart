{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "--no-install",
        "playwright-mcp",
        "--headless",
        "--isolated",
        "--no-sandbox",
        "--device",
        "iPhone 13",
        "--caps",
        "testing",
        "--allowed-origins",
        "http://localhost:4200;https://merchstoreapi.applikuapp.com;https://fonts.googleapis.com;https://fonts.gstatic.com",
        "--output-dir",
        ".agent-out/playwright"
      ]
    }
  }
}
